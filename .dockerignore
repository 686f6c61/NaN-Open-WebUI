# Evitar que secretos, datos locales y metadatos entren en el contexto Docker.
.git
.github
**/.env
**/.env.*
!**/.env.example
**/data/
**/*.tar
**/*.tar.gz
.~lock.*#
**/backups/

# Mantener alineado con .gitignore: nunca enviar estos datos al builder.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.dump
**/*.sql.gz
**/*.sql.zst
**/*.bak
**/*.backup
**/.envrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.kdbx
**/*.har
**/*.session
/.netrc
/.pypirc
/.git-credentials
/credentials*.json
/service-account*.json
/cookies*.json
/cookies*.txt
/storage-state*.json
/auth-state*.json
**/*.log
/logs/
/tmp/
/temp/
/artifacts/
/.artifacts/
/screenshots/
/test-results/
/playwright-report/
/coverage/
**/.cache/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
