# ============================================================
#  nan-open-webui  -  configuracion
#  Copia este fichero a  .env   y rellena tus valores.
#  NUNCA subas tu .env a git ni lo compartas: contiene tu API key.
# ============================================================

# (OBLIGATORIO) Tu API key de inferencia de NaN (empieza por sk-).
#   Generala en https://cloud.nan.builders -> Settings -> API Keys.
#   Un platform token (nan_pat_...) NO sirve: la API lo rechaza para inferencia.
NAN_API_KEY=sk-pon-aqui-tu-api-key

# (OBLIGATORIO) Clave secreta para firmar las sesiones de la web.
#   Genera una unica con:   openssl rand -hex 32
#   (./setup.sh la genera por ti automaticamente)
WEBUI_SECRET_KEY=

# (OBLIGATORIO) Secreto local de SearXNG para la busqueda web.
#   Genera uno unico con:   openssl rand -hex 32
#   (./setup.sh lo genera por ti automaticamente)
SEARXNG_SECRET=

# (OPCIONAL) Imagen Docker de Open WebUI a usar. Por defecto la imagen
#   preconfigurada de NaN publicada en GHCR, fijada a esta version.
#   Para actualizar, sube el tag (p. ej. v1.0.1) y reinicia; 'latest' iria
#   siempre a la ultima (menos controlado).
OPENWEBUI_IMAGE=ghcr.io/686f6c61/nan-open-webui:v1.0.1

# (OPCIONAL) Imagen de SearXNG, fijada por tag de fecha.
#SEARXNG_IMAGE=searxng/searxng:2026.10.27-ef7bae9dd

# (OPCIONAL) Interfaz donde se publica el puerto. Por defecto solo tu propio
#   equipo (127.0.0.1). Pon 0.0.0.0 para compartir la web en tu red local.
#   Para exponerla a internet usa un proxy con HTTPS: ver PRODUCCION.md.
WEBUI_BIND=127.0.0.1

# (OPCIONAL) Puerto local donde se publica la web. Por defecto 3000.
WEBUI_PORT=3000

# (OPCIONAL) Nombre que aparece en la interfaz.
WEBUI_NAME=NaN Chat

# Logo de la comunidad NaN (simbolo de Helmcode) en el favicon, la barra lateral y la
# pantalla de carga. La insignia "Built with NaN" de la entrada se muestra siempre.
# AVISO: la licencia de Open WebUI prohibe cambiar su logo en instalaciones de mas de
# 50 usuarios en 30 dias sin su permiso por escrito. Si es tu caso, pon NAN_LOGO=false.
NAN_LOGO=true

# Foto de perfil de quien no tiene foto (o pulsa "Eliminar" en Ajustes > Cuenta): el
# icono de NaN (true) o la silueta gris de Open WebUI (false). Las cuentas nuevas
# nacen con sus iniciales, que genera Open WebUI.
NAN_AVATAR=true

# (OPCIONAL) Registro abierto (true) o cerrado (false, por defecto). Cerrado, nadie
#   puede crearse una cuenta desde la entrada: solo el admin da de alta usuarios en
#   Administracion > Usuarios. La primera cuenta (la del admin) se crea igualmente.
ENABLE_SIGNUP=false

# (OPCIONAL) Rol de los nuevos registros: 'pending' (un admin los aprueba desde
#   el panel, recomendado si se registra otra gente) o 'user' (entran directos).
DEFAULT_USER_ROLE=pending

# (OPCIONAL) Respetar el control de acceso a modelos por grupo (false,
#   recomendado: todos ven todos los modelos salvo que un admin restrinja
#   alguno). 'true' desactiva ese control por completo.
BYPASS_MODEL_ACCESS_CONTROL=false

# (OPCIONAL) Open WebUI guarda su configuracion en su base de datos interna:
#   lo que se cambia en el panel de administracion manda sobre este .env.
#   Ponlo en 'false' para que el .env sea siempre la fuente de verdad (los
#   cambios hechos en el panel se perderan al reiniciar). Ver README.
#ENABLE_PERSISTENT_CONFIG=true

# (OPCIONAL) URL publica de la web si la publicas con dominio propio
#   (p. ej. https://chat.tudominio.com). Ver PRODUCCION.md.
#WEBUI_URL=

# (OPCIONAL) Origenes permitidos para CORS, separados por ';'. Por defecto '*'.
#   En produccion acotalo a tu dominio.
#CORS_ALLOW_ORIGIN=*

# (OPCIONAL) Endpoint OpenAI-compatible. Para Helmcode: https://api.helmcode.com/v1
OPENAI_API_BASE_URL=https://api.nan.builders/v1

# (OPCIONAL) Modelos de chat visibles en Open WebUI (catalogo de NaN, octubre 2026).
#   Esto evita que modelos de imagen/audio/embeddings/rerank aparezcan como chat.
#   - deepseek-v4-flash : el recomendado para empezar. Vision, 1M de contexto.
#   - glm5.3-flash      : multimodal, agentes. Siempre razona.
#   - qwen3.8-flash     : vision, agentes. Razona por defecto.
#   - mimo-v2.6-flash   : omnimodal (imagen y audio de entrada).
#   - gemma4 / qwen3.6  : generacion anterior, mas pequenos (262K de contexto).
#   - glm5.3            : SOLO con la membresia premium GLM 5.3; anadelo a la
#                         lista si la tienes (sin ella NaN responde 401).
#   Lista exacta para tu key: curl https://api.nan.builders/v1/models -H "Authorization: Bearer $NAN_API_KEY"
OPENAI_API_CONFIGS={"0":{"enable":true,"model_ids":["deepseek-v4-flash","glm5.3-flash","mimo-v2.6-flash","qwen3.8-flash","gemma4","qwen3.6"]}}

# (OPCIONAL) Modelo seleccionado por defecto en los chats nuevos.
DEFAULT_MODELS=deepseek-v4-flash

# (OPCIONAL) Parametros por defecto para todos los modelos, en JSON.
#   Vacio ({}) = tool calling nativo: el modelo decide cuando buscar en internet,
#     generar imagenes o consultar tus documentos (verificado con todos los
#     modelos de chat de NaN). {"function_calling":"legacy"} vuelve al modo
#     clasico, en el que Open WebUI ejecuta las integraciones activadas sin
#     preguntar al modelo.
#   reasoning_effort: cuanto razona el modelo antes de responder. Valores de NaN:
#     none, minimal, low, medium, high, xhigh, max. Sin el parametro, todos los
#     modelos razonan. 'none' lo apaga (salvo glm5.3/glm5.3-flash, que lo tratan
#     como 'minimal'). Ejemplo: {"reasoning_effort":"low"}
DEFAULT_MODEL_PARAMS={}

# (OPCIONAL) Ahorro de tokens en modo nativo. En cada mensaje Open WebUI envia al
#   modelo la descripcion de todas sus herramientas: medido, 24.000 caracteres para
#   una pregunta de una linea. Por defecto se apagan las herramientas integradas
#   poco usadas (calendario, automatizaciones, tareas, notas, canales)
#   via DEFAULT_MODEL_METADATA y se activa la Tool Search: las herramientas largas
#   viajan solo por nombre y el modelo las carga cuando las necesita. Resultado:
#   5.600 caracteres, un 77 % menos. 'false' desactiva la Tool Search (experimental).
#ENABLE_TOOL_SEARCH=true
# Limite de caracteres de cada pagina web que lee el modelo. Vacio = sin limite
#   (una pagina larga puede meter ~80.000 caracteres en la conversacion). Ej.: 20000
#WEB_FETCH_MAX_CONTENT_LENGTH=

# (OPCIONAL) Busqueda web. Viene activada y no necesita ninguna API key (usa el
#   buscador propio SearXNG que ya esta incluido). Ponlo en 'false' para desactivarla.
ENABLE_WEB_SEARCH=true

# (OPCIONAL) Voz con la que el chat lee las respuestas (modelo 'kokoro' de NaN).
#   Espanol: ef_dora (mujer), em_alex (hombre). Ingles: af_heart, af_sky,
#   am_adam, bf_emma... (67 voces en total).
AUDIO_TTS_VOICE=ef_dora

# (OPCIONAL) Dictado por voz. Vacio = whisper local dentro del contenedor (el
#   audio no sale de tu equipo). 'openai' = whisper large-v3 de NaN (mas preciso;
#   maximo 25 MB y unos 2 minutos por audio).
AUDIO_STT_ENGINE=

# (OPCIONAL) RAG: busqueda hibrida (palabras clave + vectores) y reordenado con
#   el modelo 'rerank' de NaN (Qwen3-Reranker-8B). 'false' = solo vectores.
ENABLE_RAG_HYBRID_SEARCH=true

# (OPCIONAL) PDF: extraer las imagenes para que el OCR lea tambien las paginas que
#   son solo imagen (escaneados). Mas lento al subir PDFs grandes.
PDF_EXTRACT_IMAGES=true

# (OPCIONAL) Plantilla con la que el modelo responde usando documentos y busquedas.
#   Vacia = la de NaN (branding/rag-template.txt): prioriza los documentos, copia
#   cifras exactas, avisa si faltan datos o las fuentes se contradicen y cita [id].
RAG_TEMPLATE=

# (OPCIONAL) Imagenes de NaN. Requiere membresia inference-tier.
#   Cuota compartida entre ambos modelos: 100 imagenes/mes y 20 peticiones/min.
#   - Generar: 'qwen-image-2.1' (mas fiel al prompt y con texto legible dentro
#     de la imagen; ~1 min por imagen; 512-1280 px en multiplos de 16).
#     Para algo mas rapido (~7 s) y sencillo: IMAGE_GENERATION_MODEL=flux-2-klein
#   - Editar / imagen a imagen: 'flux-2-klein' (qwen-image no edita; 256-1536 px).
#   Ejemplos de tamano validos para ambos: 512x512, 1024x1024, 1280x768.
ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_EDIT=true
ENABLE_IMAGE_PROMPT_GENERATION=false
IMAGE_GENERATION_MODEL=qwen-image-2.1
IMAGE_EDIT_MODEL=flux-2-klein
IMAGE_SIZE=1024x1024
IMAGE_EDIT_SIZE=1024x1024
# Parametros extra para /v1/images/generations, en JSON. Vacio = {"size":IMAGE_SIZE}:
#   fija el tamano porque el modelo de chat a veces pide 1536x1024, que
#   qwen-image-2.1 rechaza. Si lo rellenas, incluye tu el size.
#   NaN acepta tambien seed (ambos modelos) y guidance (solo flux-2-klein).
# Ejemplo: IMAGES_OPENAI_PARAMS={"size":"1024x1024","seed":1234}
IMAGES_OPENAI_PARAMS=

# (OPCIONAL) Modelo de NaN para las tareas internas (titulos, etiquetas, sugerencias).
#   Cada mensaje genera 3 de estas peticiones, de unos 320 tokens cada una.
#   deepseek-v4-flash sin razonamiento: 20/20, 1,8 s de mediana por titulo.
#   Alternativa sin gastar cuota: gemma4 (rapido, pero con picos de ~7 s y fallos
#   intermitentes cuando su cluster va cargado).
TASK_MODEL_EXTERNAL=deepseek-v4-flash
# Parametros para esas tareas. Sin razonamiento: 1,5-2,3 s y 12 tokens por titulo.
TASK_MODEL_PARAMS={"reasoning_effort":"none"}

# Open Terminal (activado de serie): un terminal y navegador de ficheros que el
#   modelo usa para crear documentos, webs, diagramas o videos con las skills. Es
#   una shell real dentro de su propio contenedor; solo los admins pueden usarlo
#   salvo que des permiso a un grupo en Admin > Settings > Integrations.
#   La clave: ./setup.sh genera OPEN_TERMINAL_API_KEY y la copia en "key". A mano,
#   pon el mismo valor en los dos sitios. Para apagarlo, comenta estas dos lineas.
COMPOSE_PROFILES=terminal
TERMINAL_SERVER_CONNECTIONS=[{"id":"open-terminal","name":"Open Terminal","url":"http://open-terminal:8000","key":"PON_AQUI_OPEN_TERMINAL_API_KEY","auth_type":"bearer","enabled":true}]
OPEN_TERMINAL_API_KEY=
