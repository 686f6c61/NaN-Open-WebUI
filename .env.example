# ============================================================
#  nan-open-webui  -  configuracion
#  Copia este fichero a  .env   y rellena tus valores.
#  NUNCA subas tu .env a git ni lo compartas: contiene tu API key.
# ============================================================

# (OBLIGATORIO) Tu API key de NaN.  Consiguela en https://nan.builders
NAN_API_KEY=sk-pon-aqui-tu-api-key

# (RECOMENDADO) Clave secreta para firmar las sesiones de la web.
#   Genera una unica con:   openssl rand -hex 32
#   (./setup.sh la genera por ti automaticamente)
WEBUI_SECRET_KEY=

# (OBLIGATORIO) Secreto local de SearXNG para la busqueda web.
#   Genera uno unico con:   openssl rand -hex 32
#   (./setup.sh lo genera por ti automaticamente)
SEARXNG_SECRET=

# (OPCIONAL) Imagen Docker de Open WebUI a usar. Por defecto la imagen
#   preconfigurada de NaN publicada en GHCR, fijada a esta version.
#   Para actualizar, sube el tag (p. ej. v0.0.9) y reinicia; 'latest' iria
#   siempre a la ultima (menos controlado).
OPENWEBUI_IMAGE=ghcr.io/686f6c61/nan-open-webui:v0.0.8

# (OPCIONAL) Interfaz donde se publica el puerto. Por defecto solo tu propio
#   equipo (127.0.0.1). Pon 0.0.0.0 para compartir la web en tu red local.
#   Para exponerla a internet usa un proxy con HTTPS: ver PRODUCCION.md.
WEBUI_BIND=127.0.0.1

# (OPCIONAL) Puerto local donde se publica la web. Por defecto 3000.
WEBUI_PORT=3000

# (OPCIONAL) Nombre que aparece en la interfaz.
WEBUI_NAME=NaN Chat

# (OPCIONAL) Permitir que otros se registren (true) o cerrar el registro (false).
#   Deja 'true' la primera vez para crear tu cuenta admin; luego puedes ponerlo en 'false'.
ENABLE_SIGNUP=true

# (OPCIONAL) Rol de los nuevos registros: 'pending' (un admin los aprueba desde
#   el panel, recomendado si se registra otra gente) o 'user' (entran directos).
DEFAULT_USER_ROLE=pending

# (OPCIONAL) Respetar el control de acceso a modelos por grupo (false,
#   recomendado: todos ven todos los modelos salvo que un admin restrinja
#   alguno). 'true' desactiva ese control por completo.
BYPASS_MODEL_ACCESS_CONTROL=false

# (OPCIONAL) Open WebUI guarda su configuracion en su base de datos interna:
#   lo que se cambia en el panel de administracion manda sobre este .env.
#   Ponlo en 'false' para que el .env sea siempre la fuente de verdad (los
#   cambios hechos en el panel se perderan al reiniciar). Ver README.
#ENABLE_PERSISTENT_CONFIG=true

# (OPCIONAL) URL publica de la web si la publicas con dominio propio
#   (p. ej. https://chat.tudominio.com). Ver PRODUCCION.md.
#WEBUI_URL=

# (OPCIONAL) Origenes permitidos para CORS, separados por ';'. Por defecto '*'.
#   En produccion acotalo a tu dominio.
#CORS_ALLOW_ORIGIN=*

# (OPCIONAL) Endpoint OpenAI-compatible. Cambialo solo si usas otro (p. ej. Helmcode).
OPENAI_API_BASE_URL=https://api.nan.builders/v1

# (OPCIONAL) Modelos de chat visibles en Open WebUI.
#   Esto evita que modelos de imagen/audio/embeddings aparezcan como modelos de chat.
OPENAI_API_CONFIGS={"0":{"enable":true,"model_ids":["qwen3.6","deepseek-v4-flash","mimo-v2.5","gemma4"]}}

# (OPCIONAL) Fuerza herramientas legacy. Necesario para que la herramienta Imagen
#   dispare flux-2-klein aunque el modelo de chat no declare tool calling nativo.
DEFAULT_MODEL_PARAMS={"function_calling":"legacy"}

# (OPCIONAL) Busqueda web. Viene activada y no necesita ninguna API key (usa el
#   buscador propio SearXNG que ya esta incluido). Ponlo en 'false' para desactivarla.
ENABLE_WEB_SEARCH=true

# (OPCIONAL) Voz con la que el chat lee las respuestas (modelo 'kokoro' de NaN).
#   Otras: af_bella, af_nicole, am_adam, bf_emma...  El dictado por voz (entrada)
#   usa un whisper local del contenedor y no necesita configurarse.
AUDIO_TTS_VOICE=af_sky

# (OPCIONAL) Imagenes con 'flux-2-klein' de NaN.
#   Requiere membresia inference-tier en NaN. Resolucion: 256-1536 px,
#   en multiplos de 16 y aspect ratio entre 1:3 y 3:1.
#   Ejemplos validos: 512x512, 1024x1024, 1536x1024, 1024x1536.
ENABLE_IMAGE_GENERATION=true
ENABLE_IMAGE_EDIT=true
ENABLE_IMAGE_PROMPT_GENERATION=false
IMAGE_GENERATION_MODEL=flux-2-klein
IMAGE_EDIT_MODEL=flux-2-klein
IMAGE_SIZE=1024x1024
IMAGE_EDIT_SIZE=1024x1024
# Parametros extra opcionales para /v1/images/generations, en JSON.
#   NaN acepta seed y guidance. La edicion de imagenes usa los campos estandar
#   que envia Open WebUI.
# Ejemplo: IMAGES_OPENAI_PARAMS={"seed":1234,"guidance":3.5}
IMAGES_OPENAI_PARAMS=

# (OPCIONAL) Modelo de NaN para las tareas internas (titulos, etiquetas, autocompletado).
#   Conviene uno rapido y barato.
TASK_MODEL_EXTERNAL=deepseek-v4-flash
